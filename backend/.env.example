# ==============================================================================
# Yebente - Safaricom M-Pesa to Bitcoin Lightning Settlement Engine (.env)
# ==============================================================================

# Server Environment
PORT=8080
ENVIRONMENT=development
# DATABASE_URL=postgres://yebente:password@localhost:5432/yebente_db?sslmode=disable

# ==============================================================================
# 1. OPTION A: LNbits Lightning Wallet (Easiest to send real sats)
# Use your self-hosted or cloud LNbits instance
# ==============================================================================
# LNBITS_URL=https://legend.lnbits.com
# LNBITS_ADMIN_KEY=your_lnbits_admin_key_here

# ==============================================================================
# 2. OPTION B: Blink / Galoy Lightning Wallet
# Get your API key in the Blink mobile app or https://dashboard.blink.sv
# ==============================================================================
# BLINK_API_KEY=blink_api_key_here

# ==============================================================================
# 3. OPTION C: LND Node (REST API)
# Connect to your Umbrel, Start9, BTCPay Server, or Voltage LND Node
# ==============================================================================
# LND_REST_URL=https://127.0.0.1:8080
# LND_MACAROON_HEX=0201036c6e...

# ==============================================================================
# 4. OPTION D: Native LND Node (gRPC)
# ==============================================================================
# LND_GRPC_ADDRESS=localhost:10009
# LND_MACAROON_PATH=/path/to/admin.macaroon
# LND_TLS_CERT_PATH=/path/to/tls.cert

# ==============================================================================
# 5. Safaricom Daraja M-Pesa Credentials (Sandbox or Production)
# ==============================================================================
DARAJA_BASE_URL=https://sandbox.safaricom.co.ke
DARAJA_CONSUMER_KEY=daraja_sandbox_key
DARAJA_CONSUMER_SECRET=daraja_sandbox_secret
DARAJA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
DARAJA_SHORTCODE=174379
DARAJA_CALLBACK_URL=https://api.yebente.com/v1/mpesa/callback
