# Application
PORT=8080
ENVIRONMENT=production

# GCP Secret Names (Loaded at runtime via Secret Manager)
GCP_PROJECT_ID=yebente-production
SECRET_DARAJA_CONSUMER_KEY=daraja-consumer-key
SECRET_DARAJA_CONSUMER_SECRET=daraja-consumer-secret
SECRET_DARAJA_PASSKEY=daraja-passkey
SECRET_LND_MACAROON_HEX=lnd-offchain-macaroon-hex
SECRET_LND_TLS_CERT=lnd-tls-cert-pem

# Direct Environment Variables (Alternative to Secret Manager for local development)
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_PASSKEY=

# Database (Cloud SQL Private IP or Local Postgres)
DATABASE_URL=postgres://yebente_app:DB_PASSWORD@10.0.1.3:5432/yebente_db?sslmode=verify-full&sslrootcert=/etc/ssl/certs/server-ca.pem

# Safaricom Daraja Settings
DARAJA_BASE_URL=https://api.safaricom.co.ke
DARAJA_SHORTCODE=600999
DARAJA_CALLBACK_URL=https://api.yebente.com/v1/mpesa/callback

# LND Private Node Address (VPC Internal IP)
LND_GRPC_ADDRESS=10.0.2.15:10009
LND_MACAROON_HEX=
LND_TLS_CERT=
